# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# provider "gemini-api": key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# provider "vertex-ai": your Google Cloud project (uses Application Default Credentials)
# GOOGLE_CLOUD_PROJECT=

# Optional: shared token if gemini.config.ts sets auth.bearerTokenEnv = 'AI_SERVER_TOKEN'
# AI_SERVER_TOKEN=

# Optional: override the port from gemini.config.ts
# PORT=8787
