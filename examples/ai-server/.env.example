# Copy to .env and fill in. .env is git-ignored - never commit real keys.
# Only the key for the provider selected in ai.config.ts is needed.

# provider 'gemini', mode "gemini-api": key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# provider 'gemini', mode "vertex-ai": your Google Cloud project (uses Application Default Credentials)
# GOOGLE_CLOUD_PROJECT=

# provider 'openai' (ChatGPT): key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# provider 'gauss': key and gateway for Samsung Gauss
# GAUSS_API_KEY=
# GAUSS_BASE_URL=https://gauss.internal/v1
# GAUSS_MODEL=gauss2-flash

# Optional: shared token if ai.config.ts sets auth.bearerTokenEnv = 'AI_SERVER_TOKEN'
# AI_SERVER_TOKEN=

# Optional: override the port from ai.config.ts
# PORT=8787